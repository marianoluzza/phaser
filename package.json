{
  "name": "phaser-tetris",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "shots": "node scripts/screenshots.mjs",
    "sim:astro": "node scripts/astro-sim.mjs",
    "audio:catalog": "node scripts/generate-audio-catalog.mjs",
    "audio:upload:r2": "node scripts/upload-audio-r2.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name phaser-arcade --branch main",
    "preview": "vite preview"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "@sentry/browser": "^10.66.0",
    "phaser": "^4.1.0"
  }
}
