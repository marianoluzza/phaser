# Identificador único por despliegue; usar preferentemente el SHA del commit.
VITE_SENTRY_RELEASE=phaser-arcade@<git-sha>

# Opcional: Vite ya informa "development" o "production" mediante su modo.
# VITE_SENTRY_ENVIRONMENT=staging

# El DSN es público y el proyecto tiene uno predeterminado. Sólo hace falta
# definirlo si se desea enviar eventos a otro proyecto de Sentry.
# VITE_SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
