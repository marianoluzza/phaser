# El HTML y el catálogo deben revalidarse para descubrir cada despliegue.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/audio/catalog.json
  Cache-Control: public, max-age=0, must-revalidate

# Vite agrega un hash al nombre de estos archivos. Pueden guardarse un año:
# cuando cambia el código, cambia también la URL.
/assets/*.js
  Cache-Control: public, max-age=31556952, immutable

/assets/*.css
  Cache-Control: public, max-age=31556952, immutable

# Encabezados básicos para toda la aplicación estática.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
